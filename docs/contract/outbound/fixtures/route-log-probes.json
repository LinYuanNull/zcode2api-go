      "request": "{\"model\": \"GLM-5.3\", \"max_tokens\": 16, \"stream\": \"false\", \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
      "expect": {"model": "GLM-5.3", "stream": true, "stream_label": "stream", "preview": "hi"},
