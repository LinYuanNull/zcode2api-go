  "stream_truthiness_affects_response_path": [
    {"id": "m-true__json", "endpoint": "/v1/messages", "stream": true, "upstream": "JSON", "observed": "200 application/json（照搬上游体）"},
    {"id": "m-true__sse", "endpoint": "/v1/messages", "stream": true, "upstream": "SSE", "observed": "200 text/event-stream（照搬）"},
    {"id": "m-strfalse__sse", "endpoint": "/v1/messages", "stream": "\"false\"", "upstream": "SSE", "observed": "200 text/event-stream（照搬）"},
    {"id": "m-1__sse", "endpoint": "/v1/messages", "stream": 1, "upstream": "SSE", "observed": "200 text/event-stream（照搬）"},
    {"id": "m-absent__sse", "endpoint": "/v1/messages", "stream": "（无）", "upstream": "SSE", "observed": "200 text/event-stream（照搬）"},
    {"id": "m-false__sse", "endpoint": "/v1/messages", "stream": false, "upstream": "SSE", "observed": "200 text/event-stream（照搬）"},
    {"id": "c-true__json", "endpoint": "/v1/chat/completions", "stream": true, "upstream": "JSON", "observed": "200 text/event-stream（**转成 OpenAI SSE**）"},
    {"id": "c-strfalse__sse", "endpoint": "/v1/chat/completions", "stream": "\"false\"", "upstream": "SSE", "observed": "200 text/event-stream（**转成 OpenAI SSE**）"},
    {"id": "c-absent__sse", "endpoint": "/v1/chat/completions", "stream": "（无）", "upstream": "SSE", "observed": "**502** `{\"error\":{\"message\":\"上游响应格式异常\",\"type\":\"upstream_error\"}}`"}
  ],
  "_response_path_conclusion": "**`/v1/messages` 的响应与入站的 `stream` 字段完全无关** —— 上游给 JSON 就回 JSON、给 SSE 就回 SSE（纯透传）。`stream` 只在 `/v1/chat/completions` 上决定响应形状，且同样用**真值**判定。",
  "response_header_probes": [
    {
      "id": "h-ct-textplain",
      "upstream_headers": "Content-Type: text/plain",
      "inbound_headers": "content-type: text/plain; charset=utf-8",
      "conclusion": "Content-Type **照搬上游**，`text/*` 被 uvicorn/Starlette 追加 `; charset=utf-8`。"
    },
    {
      "id": "h-ct-custom-plus-extra",
      "upstream_headers": "Content-Type: text/x-probe, X-Custom-Probe: abc",
      "inbound_headers": "content-type: text/x-probe; charset=utf-8（**没有** X-Custom-Probe）",
      "conclusion": "**只搬 Content-Type**，上游的其它响应头**不透传**。"
    },
    {
      "id": "h-always-cache-control",
      "upstream_headers": "（默认 application/json）",
      "inbound_headers": "cache-control: no-cache, content-type, date, server: uvicorn, transfer-encoding: chunked",
      "conclusion": "入站**总是**带 `cache-control: no-cache`；`server` / `date` / `transfer-encoding` 是 uvicorn 自己加的。"
    }
  ],
  "derived_rules": {
    "preview": "遍历 messages（必须是数组、元素必须是对象）：role 严格等于 \"user\" 时 —— content 是字符串 ⇒ preview = 它；content 是数组 ⇒ 取第一个 `type==\"text\"` 块的 `text`（缺 text 键 ⇒ 空串）；两者都取不到 ⇒ **不动** preview。",
    "model": "`body.get(\"model\") or \"-\"`（缺键 / null / 空串 ⇒ `-`）。",
    "stream": "`bool(body.get(\"stream\"))` 的 Python 真值语义。",
    "reqid": "16 位小写 hex，同一请求的所有日志行共用。",
    "response_headers": "只搬上游的 Content-Type（text/* 追加 charset），另外总是加 `cache-control: no-cache`。"
  }
}
