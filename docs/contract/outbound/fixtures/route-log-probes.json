    },
    {
      "id": "p-stream-false",
      "request": "{\"model\": \"GLM-5.3\", \"max_tokens\": 16, \"stream\": false, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
      "expect": {"model": "GLM-5.3", "stream": false, "stream_label": "sync", "preview": "hi"}
    },
    {
      "id": "p-stream-absent",
      "request": "{\"model\": \"GLM-5.3\", \"max_tokens\": 16, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
      "expect": {"model": "GLM-5.3", "stream": false, "stream_label": "sync", "preview": "hi"}
    },
    {
      "id": "p-stream-null",
      "request": "{\"model\": \"GLM-5.3\", \"max_tokens\": 16, \"stream\": null, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
      "expect": {"model": "GLM-5.3", "stream": false, "stream_label": "sync", "preview": "hi"}
    },
    {
