    },
    {
      "id": "p-model-null",
      "request": "{\"model\": null, \"max_tokens\": 16, \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
      "expect": {"model": "", "model_label": "-", "stream": false, "preview": "hi"},
