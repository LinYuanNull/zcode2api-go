    },
    {
      "id": "p-stream-emptystr",
      "request": "{\"model\": \"GLM-5.3\", \"max_tokens\": 16, \"stream\": \"\", \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
