{
  "id": "<string> 服务端生成，形态 <slug>-<8hex>",
  "name": "<string> 用户给的显示名，可为空",
  "provider": "<enum> zai | bigmodel",
  "mode": "<enum> apiKey | jwt",
  "jwt_token": "<string|null> jwt 模式的凭据；apiKey 模式下为 null",
  "api_key": "<string|null> apiKey 模式的凭据；jwt 模式下为 null",
  "enabled": "<bool> 与 accounts.enabled 列同义",
  "status": "<enum> active | disabled | cooling | exhausted | invalid",
  "quota": "<object> 额度快照，空账号为 {}",
  "plan": "<object> 当前套餐，空账号为 {}",
  "plans": "<array> 套餐列表，空账号为 []",
  "usage": "<object> 用量累计，空账号为 {}",
  "use_count": "<int> 成功调用次数",
  "fail_count": "<int> 连续失败次数",
  "risk_strikes": "<int> 风控命中计数",
  "last_risk_at": "<float|null> epoch 秒",
  "recent_results": "<array> 最近结果环形列表，空账号为 []",
  "last_used_at": "<float|null> epoch 秒",
  "last_checked_at": "<float|null> epoch 秒",
  "cooling_until": "<float|null> epoch 秒",
  "last_error": "<string|null>",
  "created_at": "<float> epoch 秒（带小数），与 accounts.created_at 列一致",
  "fingerprint": "<object> 见 fingerprint-shape.json",
  "install_id": "<string> 账号级安装标识，uuid4 形态",
  "installed_at": "<float|null> epoch 秒"
}
