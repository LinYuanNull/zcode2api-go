{
  "route": "/v1/messages",
  "method": "POST",
  "request": {
    "query": {},
    "headers": {
      "Authorization": "<redacted:bearer>",
      "Content-Type": "application/json"
    },
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "hi",
          "role": "user"
        }
      ],
      "model": "glm-4.6"
    }
  },
  "response": {
    "status": 503,
    "headers": {
