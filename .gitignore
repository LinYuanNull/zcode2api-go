# 构建产物
/zcode2api-go
/zcode2api-go.exe
/dist/
*.exe

# 运行时数据（账号库 / 设备指纹 / 日志 / 缓存）
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# 例外：A2 契约夹具的账号库**必须入库** —— 它是 `go test` 的输入，
# 也是「能读现有 accounts.db」这条验收的可复现依据。
# 该库由 tools/samplefixture 在独立临时数据目录里生成，只含合成数据
# （api_key 形如 fixture-token-NNNN、gateway_key 为合成值），不含任何真实凭据。
!docs/contract/store/fixtures/target.db

# 本地配置与密钥
/.env
/config.local.*

# e2e 隔离夹具（tools/e2e_panel.py 的可再生产物：临时账号库 / Edge profile / 下载 / 日志 / 被测 exe）
/tools/e2e_home/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python 采样工具的字节码缓存
__pycache__/
*.pyc
